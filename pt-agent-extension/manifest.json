{
  "manifest_version": 3,
  "name": "PT Agent Helper",
  "version": "0.17.1",
  "description": "聚合 PT 站点 Free 资源，安全推送到可配置的多台下载器，并按网络可达性自动切换内外网地址。",
  "permissions": [
    "activeTab",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://m-team.cc/*",
    "https://*.m-team.cc/*",
    "https://*.halomt.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PT Agent Helper"
  },
  "web_accessible_resources": [
    {
      "resources": ["site-definitions.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
