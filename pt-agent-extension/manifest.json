{
  "manifest_version": 3,
  "name": "PT Agent Helper",
  "version": "0.11.0",
  "description": "聚合 M-Team Free 资源，安全推送 qBittorrent，并同步 PT Core 生命周期和新手考核数据。",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": [
    "http://192.168.1.10:8080/*",
    "https://m-team.cc/*",
    "https://*.m-team.cc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PT Agent Helper"
  },
  "web_accessible_resources": [
    {
      "resources": ["site-definitions.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
