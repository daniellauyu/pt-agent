# PT Agent 守护进程配置
# 复制成 .env 后填入你自己的地址、账号和密钥。
#
# 这个文件里有下载器密码和站点 API Key，不要提交到仓库、不要发给别人。
# 放在数据目录（默认 ~/.ptagent/.env）或运行目录下即可自动读取。
# 写在这里的项目每次启动都会覆盖 config.json 中的对应字段。

# ---- 站点 ----
PTAGENT_SITE_NAME=M-Team
PTAGENT_SITE_TYPE=mteam
PTAGENT_SITE_URL=https://kp.m-team.cc/
PTAGENT_SITE_API_URL=https://api.m-team.cc/
PTAGENT_SITE_API_KEY=

# ---- 下载器 1（顺序即探测优先级，内网放前面） ----
PTAGENT_DOWNLOADER_1_NAME=内网qB
PTAGENT_DOWNLOADER_1_TYPE=qbittorrent
PTAGENT_DOWNLOADER_1_ADDRESS=http://192.168.1.10:8080/
PTAGENT_DOWNLOADER_1_USERNAME=admin
PTAGENT_DOWNLOADER_1_PASSWORD=
PTAGENT_DOWNLOADER_1_SAVE_PATH=/volume1/downloads
PTAGENT_DOWNLOADER_1_CATEGORY=PT_AGENT
PTAGENT_DOWNLOADER_1_ENABLED=true

# ---- 下载器 2（顺序即探测优先级，内网放前面） ----
PTAGENT_DOWNLOADER_2_NAME=公网qB
PTAGENT_DOWNLOADER_2_TYPE=qbittorrent
PTAGENT_DOWNLOADER_2_ADDRESS=https://qb.example.com/
PTAGENT_DOWNLOADER_2_USERNAME=admin
PTAGENT_DOWNLOADER_2_PASSWORD=
PTAGENT_DOWNLOADER_2_SAVE_PATH=
PTAGENT_DOWNLOADER_2_CATEGORY=PT_AGENT
PTAGENT_DOWNLOADER_2_ENABLED=true

# ---- 定时扫描 ----
PTAGENT_SCAN_MIN_MINUTES=40
PTAGENT_SCAN_MAX_MINUTES=90
PTAGENT_MAX_PUSH_PER_SCAN=5
PTAGENT_AUTO_DOWNLOAD=true
PTAGENT_SCAN_ON_START=true

# ---- 下载策略 ----
PTAGENT_MIN_SCORE=80
PTAGENT_MAX_SIZE_GB=50
PTAGENT_MIN_FREE_HOURS=12
PTAGENT_MIN_RATIO=1
PTAGENT_MAX_ACTIVE_DOWNLOADS=3
PTAGENT_REJECT_HR=true
PTAGENT_REJECT_MISSING_FREE_END=true

# ---- Free 到期保护 ----
PTAGENT_GUARD_MONITOR=true
PTAGENT_GUARD_MINUTES=10
PTAGENT_GUARD_INTERVAL_SECONDS=60
PTAGENT_AUTO_DELETE_EXPIRED=true

# ---- WebUI（绑定非回环地址时必须同时设置 TOKEN，否则启动会被拒绝） ----
PTAGENT_WEB_ENABLED=true
PTAGENT_WEB_HOST=127.0.0.1
PTAGENT_WEB_PORT=7788
PTAGENT_WEB_TOKEN=

# ---- 数据目录（可选）----
# 不填则用 ~/.ptagent。配置、日志、审计都放在这里。
# 注意：这一项只有写在「运行目录的 .env」或「--env 指定的文件」里才有意义，
# 因为要先知道数据目录才能找到数据目录里的 .env。
PTAGENT_HOME=
